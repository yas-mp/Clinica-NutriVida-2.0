# URL del microservicio de Servicios (backend/servicios, Spring Boot).
# Si no se define, la aplicación usa http://localhost:8082
VITE_API_SERVICIOS_URL=http://localhost:8082

# URL del microservicio de Contacto (backend/contacto, Spring Boot).
# Si no se define, la aplicación usa http://localhost:8085
VITE_API_CONTACTO_URL=http://localhost:8085

# URL del microservicio de Pagos (backend/pago, Spring Boot).
# Si no se define, la aplicación usa http://localhost:8086
VITE_API_PAGO_URL=http://localhost:8086
